# =============================================
#  ORV JDR — Exemple de configuration
#  Copiez ce fichier en .env et remplissez
#  vos valeurs. Ne commitez JAMAIS .env.
# =============================================

# Environnement : development | production
APP_ENV=development

# ---- Base de données ----
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=orv_jdr
DB_USER=root
DB_PASSWORD=

# ---- Sécurité ----
# Algorithme de hachage PHP : PASSWORD_BCRYPT | PASSWORD_ARGON2ID | PASSWORD_DEFAULT
ENCRYPT=PASSWORD_BCRYPT

# ---- E-Mail ----
MAIL_FROM=noreply@orv-jdr.fr
MAIL_FROM_NAME=ORV JDR
# true  → écrit dans logs/mail.log au lieu d'envoyer (mode dev sans SMTP)
# false → envoie réellement via mail()
MAIL_LOG=false
